# Copy to .env (never commit real values). Local development needs none of these:
# the API uses a local SQLite file (api/local.db) by default.

# Production database (Turso). Set these in Vercel → Project → Settings → Environment Variables.
DATABASE_URL=libsql://your-database-name-your-org.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token
